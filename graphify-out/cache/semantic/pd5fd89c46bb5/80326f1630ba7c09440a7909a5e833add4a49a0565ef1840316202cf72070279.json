{"nodes": [{"id": "concurrency_page", "label": "Concurrency: Goroutines, Channels & Buffers", "file_type": "document", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concurrency_goroutines", "label": "Goroutines and M:N User-Space Scheduler", "file_type": "concept", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goroutines start with 2KB stack and are multiplexed onto OS threads by the Go runtime scheduler (GOMAXPROCS)."}, {"id": "concurrency_goroutine_leaks", "label": "Goroutine Leaks", "file_type": "rationale", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocked goroutines unable to send or receive are never collected by the GC, permanently leaking stack and heap memory."}, {"id": "concurrency_channels", "label": "Channels: CSP Shared-Memory Alternative", "file_type": "concept", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Channels implement Hoare Communicating Sequential Processes: share memory by communicating, rather than communicating by sharing memory."}, {"id": "concurrency_unbuffered_channels", "label": "Unbuffered Channels (Synchronous Rendezvous)", "file_type": "rationale", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transfers value and synchronizes sender and receiver simultaneously; sender blocks until receiver is ready and vice versa."}, {"id": "concurrency_channel_directions", "label": "Channel Directional Constraints (chan<- and <-chan)", "file_type": "concept", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restricts channels to send-only or receive-only in function signatures to enforce data flow safety at compile time."}, {"id": "concurrency_buffered_channels", "label": "Buffered Channels (Asynchronous Queue)", "file_type": "rationale", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides a fixed-capacity ring buffer; sends only block when buffer is full, providing backpressure."}, {"id": "concurrency_closing_channels", "label": "Channel Closing Semantics", "file_type": "rationale", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only senders should close a channel; sending to or closing an already closed channel panics. Receiving from closed channel drains buffer then yields zero value."}, {"id": "concurrency_nil_channel_behavior", "label": "Nil Channel Blocking Behavior", "file_type": "rationale", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading or writing to a nil channel blocks forever; used inside select to dynamically enable or disable branches."}, {"id": "concurrency_for_range_channel", "label": "For-Range Channel Iteration", "file_type": "concept", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Continuously reads values from a channel until it is closed, avoiding manual comma-ok checks."}, {"id": "concurrency_select_statement", "label": "Select Statement (Multiplexing Channels)", "file_type": "concept", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waits on multiple channel operations simultaneously, selecting pseudo-randomly when multiple channels are ready."}, {"id": "concurrency_nonblocking_select", "label": "Non-Blocking Operations via Default Case", "file_type": "concept", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A default branch in select executes immediately if no channel communication is ready, enabling non-blocking sends/receives."}, {"id": "concurrency_done_channel_pattern", "label": "Done Channel Shutdown Broadcast", "file_type": "rationale", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closing a chan struct{} broadcasts an instantaneous cancellation signal to an arbitrary number of listening goroutines."}, {"id": "concurrency_interview_questions", "label": "Concurrency Interview Questions and Answers", "file_type": "concept", "source_file": "concurrency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "concurrency_page", "target": "concurrency_goroutines", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "concurrency.html", "source_location": null, "weight": 1.0}, {"source": "concurrency_goroutines", "target": "concurrency_goroutine_leaks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "concurrency.html", "source_location": null, "weight": 1.0}, {"source": "concurrency_goroutines", "target": "concurrency_channels", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "concurrency.html", "source_location": null, "weight": 1.0}, {"source": "concurrency_channels", "target": "concurrency_unbuffered_channels", "relation": "conceptually_related_to"
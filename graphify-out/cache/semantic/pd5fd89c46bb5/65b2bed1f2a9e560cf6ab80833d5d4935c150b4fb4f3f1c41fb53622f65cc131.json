{"nodes": [{"id": "basics_page", "label": "Basics: Hello Go, Variables, Control Flow & Functions", "file_type": "document", "source_file": "basics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "basics_main_package", "label": "Main Package and Entrypoint", "file_type": "concept", "source_file": "basics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "package main defines an executable program rather than a library; execution starts at func main()."}, {"id": "basics_variables_and_types", "label": "Variable Declarations (var and :=)", "file_type": "concept", "source_file": "basics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "basics_zero_values", "label": "Zero Value Initialization", "file_type": "rationale", "source_file": "basics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Go initializes all unassigned variables to zero values (0, false, \"\", nil), preventing undefined memory reads."}, {"id": "basics_explicit_type_conversion", "label": "Explicit Type Conversion (No Implicit Casting)", "file_type": "rationale", "source_file": "basics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Go disallows implicit numeric casting to prevent subtle truncation, sign, and precision bugs."}, {"id": "basics_constants", "label": "Untyped and Typed Constants", "file_type": "concept", "source_file": "basics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "basics_variable_shadowing", "label": "Variable Shadowing with Short Declaration :=", "file_type": "rationale", "source_file": "basics.html", "source_location": null, "source_url": null, "captured_a
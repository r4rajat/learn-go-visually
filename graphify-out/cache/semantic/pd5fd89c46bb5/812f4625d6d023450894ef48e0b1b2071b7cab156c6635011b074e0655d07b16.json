{"nodes": [{"id": "operators_page", "label": "Kubernetes Operators in Go", "file_type": "document", "source_file": "operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "operators_operator_pattern", "label": "Kubernetes Operator Pattern", "file_type": "concept", "source_file": "operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encapsulates human operational knowledge in automated controllers managing Custom Resources to achieve declarative state."}, {"id": "operators_crd_design", "label": "Custom Resource Definition (CRD) Architecture", "file_type": "concept", "source_file": "operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines schema with Spec (desired state) and Status (observed state), managed via kubebuilder markers."}, {"id": "operators_reconcile_loop", "label": "Level-Triggered Reconcile Loop", "file_type": "rationale", "source_file": "operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reconciler reads actual cluster state, compares with desired spec, and applies idempotent changes until state matches."}, {"id": "operators_key_enqueue_decoupling", "label": "Key Enqueue Decoupling Pattern", "file_type": "rationale", "source_file": "operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Informers enqueue namespace/name keys rather than full objects, decoupling events from state and guaranteeing reconciler sees latest cache state."}, {"id": "operators_rate_limiting_and_requeue", "label": "Rate Limiting and Requeue Patterns", "file_type": "rationale", "source_file": "operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": nul
{"nodes": [{"id": "core_page", "label": "Core: Structs, Slices, Maps, Interfaces & Errors", "file_type": "document", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_structs", "label": "Struct Types and Value Definitions", "file_type": "concept", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_receivers", "label": "Value vs Pointer Receivers", "file_type": "rationale", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pointer receivers allow mutating receiver fields and avoid copying large structs; value receivers ensure immutability and thread safety."}, {"id": "core_struct_embedding", "label": "Struct Embedding: Composition over Inheritance", "file_type": "rationale", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Go rejects class hierarchies; embedded structs promote inner fields and methods directly into outer struct."}, {"id": "core_struct_tags", "label": "Struct Tags (JSON, BSON serialization metadata)", "file_type": "concept", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_slices_and_maps", "label": "Slices & Maps Data Structures", "file_type": "concept", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_slice_header", "label": "Slice Header (Data Pointer, Length, Capacity)", "file_type": "rationale", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slice is a lightweight 24-byte header; sub-slicing shares the underlying backing array until append exceeds capacity."}, {"id": "core_slice_append_growth", "label": "Slice Append & Backing Array Reallocation", "file_type": "rationale", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appending beyond capacity allocates a new backing array and copies existing elements, detaching from the original slice."}, {"id": "core_slice_copy", "label": "In-Memory Slice Duplication with copy()", "file_type": "concept", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_maps_and_comma_ok", "label": "Hash Maps and the Comma-OK Idiom", "file_type": "rationale", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading missing keys returns zero value; comma-ok differentiates missing key from zero value. Writing to nil map triggers fatal panic."}, {"id": "core_interfaces", "label": "Implicit Interface Implementation", "file_type": "rationale", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Types satisfy interfaces implicitly by implementing their method set without explicit declarations, enabling loose coupling."}, {"id": "core_nil_interface_trap", "label": "The Nil Interface Gotcha (Typed Nil vs Untyped Nil)", "file_type": "rationale", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An interface is a two-word pair (type, value). A non-nil interface holding a nil concrete pointer is not nil."}, {"id": "core_type_assertions_and_switches", "label": "Type Assertions and Type Switches", "file_type": "concept", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_error_interface", "label": "The Error Interface & Sentinel Errors", "file_type": "concept", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any type with an Error() string method satisfies error."}, {"id": "core_error_wrapping", "label": "Error Wrapping with %w, errors.Is and errors.As", "file_type": "rationale", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fmt.Errorf with %w builds inspectable error chains; errors.Is checks equality/unwraps, while errors.As casts to custom types."}, {"id": "core_panic_and_recover", "label": "Panic and Recover Mechanism", "file_type": "rationale", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unwinds stack on severe runtime faults; recover() stops panicking only inside deferred functions. Not for normal control flow."}, {"id": "core_interview_questions", "label": "Core Go Interview Questions and Answers", "file_type": "concept", "source_file": "core.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "core_page", "target": "core_structs", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "core.html", "source_location": null, "weight": 1.0}, {"source": "core_structs", "target": "core_receivers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "core.html", "source_location": null, "weight": 1.0}, {"source": "core_structs", "target": "core_struct_embedding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "